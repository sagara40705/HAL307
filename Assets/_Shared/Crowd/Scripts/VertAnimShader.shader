Shader "Custom/VertAnimShader"
{
    Properties
    {
        _MainTex("Texture", 2D) = "white" {}

        _PosTex("Position texture", 2D) = "black" {}

        _NmlTex("Normal texture", 2D) = "white" {}

        _Length("Animation Length", Float) = 1

        _FramesPerAnim("Frames Per Animation", Float) = 60

        _AnimIndex("Animation Index", Float) = 0
    }


    SubShader
    {
        Pass
        {
            CGPROGRAM

            #pragma vertex vert
            #pragma fragment frag

            #pragma multi_compile_instancing

            #include "UnityCG.cginc"


            // =================================================
            // テクスチャ
            // =================================================

            sampler2D _MainTex;

            sampler2D _PosTex;

            sampler2D _NmlTex;


            // =================================================
            // VATデータ
            // =================================================

            float4 _PosTex_TexelSize;

            float _Length;

            float _FramesPerAnim;


            // =================================================
            // アニメーション番号
            // =================================================
            //
            // 重要：
            //
            // 現在は通常のマテリアルプロパティとして扱う。
            //
            // インスタンスごとのプロパティにはしない。
            //
            // このCrowdSpawner内の全キャラクターは
            // 同じアニメーションを使用する。
            //
            float _AnimIndex;


            // =================================================
            // インスタンスごとのデータ
            // =================================================
            //
            // DTは引き続きキャラクターごとに異なる値を持つ。
            //
            UNITY_INSTANCING_BUFFER_START(Props)

                UNITY_DEFINE_INSTANCED_PROP(
                    float,
                    _DT
                )

            UNITY_INSTANCING_BUFFER_END(Props)


            // =================================================
            // 頂点入力
            // =================================================

            struct appdata
            {
                float2 uv : TEXCOORD0;

                UNITY_VERTEX_INPUT_INSTANCE_ID
            };


            // =================================================
            // 頂点出力
            // =================================================

            struct v2f
            {
                float2 uv : TEXCOORD0;

                float3 normal : TEXCOORD1;

                float4 vertex : SV_POSITION;
            };


            // =================================================
            // 頂点シェーダー
            // =================================================

            v2f vert(
                appdata v,
                uint vid : SV_VertexID
            )
            {
                UNITY_SETUP_INSTANCE_ID(v);


                v2f o;


                // -------------------------------------------------
                // アニメーション番号
                // -------------------------------------------------
                //
                // 通常のマテリアルプロパティ。
                //
                float animIndex =
                    _AnimIndex;


                // -------------------------------------------------
                // インスタンスごとの時間オフセット
                // -------------------------------------------------

                float dt =
                    UNITY_ACCESS_INSTANCED_PROP(
                        Props,
                        _DT
                    );


                // -------------------------------------------------
                // アニメーション時間
                // -------------------------------------------------

                float t =
                    (_Time.y - dt) /
                    _Length;


                t =
                    frac(t);


                // -------------------------------------------------
                // フレーム
                // -------------------------------------------------

                float frame =
                    floor(
                        t *
                        (_FramesPerAnim - 1)
                    );


                // -------------------------------------------------
                // 位置テクスチャの座標
                // -------------------------------------------------

                float x =
                    (vid + 0.5) *
                    _PosTex_TexelSize.x;


                float y =
                    (
                        animIndex *
                        _FramesPerAnim
                        +
                        frame
                        +
                        0.5
                    ) *
                    _PosTex_TexelSize.y;


                // -------------------------------------------------
                // VATの位置
                // -------------------------------------------------

                float4 pos =
                    tex2Dlod(
                        _PosTex,
                        float4(
                            x,
                            y,
                            0,
                            0
                        )
                    );


                // -------------------------------------------------
                // VATの法線
                // -------------------------------------------------

                float3 normal =
                    tex2Dlod(
                        _NmlTex,
                        float4(
                            x,
                            y,
                            0,
                            0
                        )
                    ).xyz;


                // -------------------------------------------------
                // 位置の変換
                // -------------------------------------------------

                o.vertex =
                    UnityObjectToClipPos(pos);


                // -------------------------------------------------
                // 法線の変換
                // -------------------------------------------------

                o.normal =
                    UnityObjectToWorldNormal(
                        normal
                    );


                // -------------------------------------------------
                // UV
                // -------------------------------------------------

                o.uv =
                    v.uv;


                return o;
            }


            // =================================================
            // フラグメントシェーダー
            // =================================================

            half4 frag(
                v2f i
            ) : SV_TARGET
            {
                // -------------------------------------------------
                // 簡易ライティング
                // -------------------------------------------------

                half3 lightDir =
                    normalize(
                        float3(
                            0,
                            1,
                            0
                        )
                    );


                half diff =
                    dot(
                        i.normal,
                        lightDir
                    ) *
                    0.5 +
                    0.5;


                // -------------------------------------------------
                // 基本色
                // -------------------------------------------------

                half4 col =
                    tex2D(
                        _MainTex,
                        i.uv
                    );


                return col * diff;
            }

            ENDCG
        }
    }
}
