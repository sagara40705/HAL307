#ifndef MY_SHADER_INCLUDED
#define MY_SHADER_INCLUDED

// ------------------------------------------------------------
// URPの基本関数を読み込む
// 座標変換やカメラ情報などの関数がここに入っている
// ------------------------------------------------------------
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

// ------------------------------------------------------------
// URPのライト計算用関数
// メインライトの取得や影計算がここに入っている
// ------------------------------------------------------------
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl"


// ------------------------------------------------------------
// マテリアルからGPUへ送られる値
// SRP Batcher対応のため UnityPerMaterial にまとめる
// ------------------------------------------------------------
CBUFFER_START(UnityPerMaterial)

    // マテリアルの色
float4 _BaseColor;

    // テクスチャのTilingとOffset
float4 _BaseMap_ST;

CBUFFER_END


// ------------------------------------------------------------
// 使用するテクスチャを宣言
// ------------------------------------------------------------
TEXTURE2D(_BaseMap);

// テクスチャサンプラー
SAMPLER(sampler_BaseMap);


// ------------------------------------------------------------
// 頂点シェーダに入るデータ
// モデルのメッシュから渡される
// ------------------------------------------------------------
struct Attributes
{
    // オブジェクト空間の頂点座標
    float3 positionOS : POSITION;

    // オブジェクト空間の法線
    float3 normalOS : NORMAL;

    // UV座標
    float2 uv : TEXCOORD0;
};


// ------------------------------------------------------------
// 頂点シェーダ → ピクセルシェーダへ渡すデータ
// ------------------------------------------------------------
struct Varyings
{
    // 画面に描画するための座標
    float4 positionCS : SV_POSITION;

    // ワールド空間座標
    float3 positionWS : TEXCOORD0;

    // ワールド空間法線
    float3 normalWS : TEXCOORD1;

    // UV座標
    float2 uv : TEXCOORD2;

    // 影計算用座標
    float4 shadowCoord : TEXCOORD3;
};


// ------------------------------------------------------------
// 頂点シェーダ
// 各頂点ごとに1回実行される
// ------------------------------------------------------------
Varyings vert(Attributes IN)
{
    // 出力用構造体
    Varyings OUT;

    // --------------------------------------------------------
    // 頂点座標の変換
    // --------------------------------------------------------

    // オブジェクト空間 → クリップ空間などへ変換
    VertexPositionInputs posInputs =
        GetVertexPositionInputs(IN.positionOS);

    // 法線変換
    VertexNormalInputs norInputs =
        GetVertexNormalInputs(IN.normalOS);

    // --------------------------------------------------------
    // 画面描画用座標
    // --------------------------------------------------------
    OUT.positionCS = posInputs.positionCS;

    // --------------------------------------------------------
    // ワールド座標
    // --------------------------------------------------------
    OUT.positionWS = posInputs.positionWS;

    // --------------------------------------------------------
    // ワールド法線
    // --------------------------------------------------------
    OUT.normalWS = norInputs.normalWS;

    // --------------------------------------------------------
    // UV座標
    // テクスチャのTiling / Offsetを適用
    // --------------------------------------------------------
    OUT.uv = TRANSFORM_TEX(IN.uv, _BaseMap);

    // --------------------------------------------------------
    // 影計算用の座標を取得
    // --------------------------------------------------------
    OUT.shadowCoord =
        TransformWorldToShadowCoord(OUT.positionWS);

    return OUT;
}


// ------------------------------------------------------------
// ピクセルシェーダ
// 各ピクセルごとに実行される
// ------------------------------------------------------------
half4 frag(Varyings IN) : SV_Target
{
    // --------------------------------------------------------
    // テクスチャから色を取得
    // --------------------------------------------------------
    half3 texColor =
        SAMPLE_TEXTURE2D(_BaseMap, sampler_BaseMap, IN.uv).rgb;

    // --------------------------------------------------------
    // テクスチャ色 × マテリアル色
    // --------------------------------------------------------
    half3 albedo =
        texColor * (half3) _BaseColor.rgb;

    // --------------------------------------------------------
    // 法線を正規化
    // --------------------------------------------------------
    half3 N = normalize(IN.normalWS);

    // --------------------------------------------------------
    // メインライト取得
    // --------------------------------------------------------
    Light mainLight =
        GetMainLight(IN.shadowCoord);

    // --------------------------------------------------------
    // 法線とライト方向の内積
    // --------------------------------------------------------
    half NdotL =
        saturate(dot(N, mainLight.direction));

    // --------------------------------------------------------
    // 拡散反射
    // --------------------------------------------------------
    half3 diffuse =
        albedo *
        mainLight.color *
        NdotL *
        mainLight.shadowAttenuation;

    // --------------------------------------------------------
    // 簡易環境光
    // --------------------------------------------------------
    half3 ambient =
        albedo * 0.08h;

    // --------------------------------------------------------
    // 最終色
    // --------------------------------------------------------
    half3 finalColor =
        diffuse + ambient;

    return half4(finalColor, _BaseColor.a);
}

#endif