Shader "Custom/flame"
{
    //============================================================
    // MaterialのInspectorに表示するパラメータ
    //============================================================
    Properties
    {
        //--------------------------------------------------------
        // UI Imageから自動的に渡されるSprite Texture
        //
        // [PerRendererData]を付けることで、
        // CanvasRendererがUIごとのSprite Textureを設定する
        //--------------------------------------------------------
        [PerRendererData] _MainTex ("Sprite Texture", 2D) = "white" {}


        //--------------------------------------------------------
        // リング本体の炎模様を作るためのノイズテクスチャ
        //
        // UVを時間によって移動させることで、
        // 炎が流れているような表現に使用する
        //--------------------------------------------------------
        _NoiseTex ("Noise Texture", 2D) = "white" {}


        //--------------------------------------------------------
        // ゲージ先端に表示する炎の形状テクスチャ
        //--------------------------------------------------------
        _FlameTex ("Flame Texture", 2D) = "black" {}


        //--------------------------------------------------------
        // 炎全体に乗算する色
        //--------------------------------------------------------
        _Color ("Color", Color) = (1,1,1,1)


        //--------------------------------------------------------
        // リングの内側半径
        //
        // UV中心からこの距離より内側は描画しない
        //--------------------------------------------------------
        _InnerRadius ("Inner Radius", Range(0, 0.5)) = 0.25


        //--------------------------------------------------------
        // リングの外側半径
        //
        // UV中心からこの距離より外側は描画しない
        //--------------------------------------------------------
        _OuterRadius ("Outer Radius", Range(0, 0.5)) = 0.4


        //--------------------------------------------------------
        // 円形ゲージの表示量
        //
        // 0.0 = 非表示
        // 0.5 = 半周
        // 1.0 = 一周
        //--------------------------------------------------------
        _FillAmount ("Fill Amount", Range(0, 1)) = 1.0


        //--------------------------------------------------------
        // 円形ゲージの描画開始角度
        //
        // 0   = 12時方向
        // 90  = 3時方向
        // 180 = 6時方向
        // 270 = 9時方向
        //--------------------------------------------------------
        _StartAngle ("Start Angle", Range(0, 360)) = 0


        //--------------------------------------------------------
        // ノイズテクスチャを流す速度
        //
        // 値を大きくすると炎模様が速く動く
        //--------------------------------------------------------
        _FlameSpeed ("Flame Speed", Range(0, 5)) = 1.2


        //--------------------------------------------------------
        // リング本体の炎模様の強さ
        //
        // ノイズによる明暗変化の強度調整に使用する
        //--------------------------------------------------------
        _FlameStrength ("Flame Strength", Range(0, 2)) = 1.0


        //--------------------------------------------------------
        // ゲージ先端に表示する炎の回転角度補正
        //
        // 0 = リング中心から外側方向
        //--------------------------------------------------------
        _FlameAngleOffset ("Flame Angle Offset", Range(-180, 180)) = 0


        //--------------------------------------------------------
        // 先端炎の縦方向の長さ
        //
        // Inspectorには表示しない
        //--------------------------------------------------------
        [HideInInspector]
        _TipLength ("Tip Length", Range(0.02, 0.35)) = 0.16


        //--------------------------------------------------------
        // 先端炎の横幅
        //
        // Inspectorには表示しない
        //--------------------------------------------------------
        [HideInInspector]
        _TipWidth ("Tip Width", Range(0.01, 0.25)) = 0.08


        //--------------------------------------------------------
        // 先端炎の明るさ・強度
        //
        // Inspectorには表示しない
        //--------------------------------------------------------
        [HideInInspector]
        _TipStrength ("Tip Strength", Range(0, 3)) = 1.4


        //--------------------------------------------------------
        // リング外周部分のぼかし幅
        //
        // 値が大きいほど外周が柔らかくなる
        //--------------------------------------------------------
        _OuterEdgeSoftness
        (
            "Outer Edge Softness",
            Range(0.001, 0.05)
        ) = 0.010
    }



    //============================================================
    // 実際の描画方法を設定する部分
    //============================================================
    SubShader
    {
        //--------------------------------------------------------
        // Shaderの描画カテゴリ・描画順などをUnityへ伝える
        //--------------------------------------------------------
        Tags
        {
            // 透明オブジェクトとして描画する
            "Queue"="Transparent"

            // Shaderの種類を透明描画として設定
            "RenderType"="Transparent"

            // Projectorの影響を受けない
            "IgnoreProjector"="True"

            // MaterialのPreviewを平面として表示
            "PreviewType"="Plane"

            // UnityのSprite Atlasを使用可能にする
            "CanUseSpriteAtlas"="True"
        }


        //--------------------------------------------------------
        // アルファブレンディング
        //
        // 最終色 =
        //
        // 描画する色 × SrcAlpha
        //
        // +
        //
        // 背景色 × (1 - SrcAlpha)
        //
        // 一般的な半透明描画の設定
        //--------------------------------------------------------
        Blend SrcAlpha OneMinusSrcAlpha


        //--------------------------------------------------------
        // カリングを無効化
        //
        // 表面・裏面の両方を描画する
        //--------------------------------------------------------
        Cull Off


        //--------------------------------------------------------
        // Depth Bufferへ深度を書き込まない
        //
        // UIは透明描画なのでZWriteを無効化する
        //--------------------------------------------------------
        ZWrite Off


        //--------------------------------------------------------
        // 深度テストを常に成功させる
        //
        // 3Dオブジェクトとの深度関係に関係なく描画する
        //--------------------------------------------------------
        ZTest Always



        //========================================================
        // 1回分の描画処理
        //========================================================
        Pass
        {
            HLSLPROGRAM


            //----------------------------------------------------
            // 使用するVertex Shader関数を指定
            //
            // flame.hlsl内のFlameVertexが実行される
            //----------------------------------------------------
            #pragma vertex FlameVertex


            //----------------------------------------------------
            // 使用するPixel Shader関数を指定
            //
            // flame.hlsl内のFlameFragmentが実行される
            //----------------------------------------------------
            #pragma fragment FlameFragment


            //----------------------------------------------------
            // Unity標準のShader関数・変数を使用する
            //
            // UnityObjectToClipPos
            // _Time
            // TRANSFORM_TEX
            //
            // などが使用可能になる
            //----------------------------------------------------
            #include "UnityCG.cginc"


            //----------------------------------------------------
            // 炎リングの実際の描画処理
            //
            // Vertex Shader
            // Pixel Shader
            // 円形ゲージ計算
            // ノイズによる炎表現
            // 先端炎描画
            //
            // などを実装している
            //----------------------------------------------------
            #include "Assets/masato/feverUI/feverUI.hlsl"


            ENDHLSL
        }
    }
}
