#ifndef FLAME_UI_INCLUDED
#define FLAME_UI_INCLUDED

//============================================================
// UI炎リング Shader
//
// このファイルでは主に以下の処理を行う
//
// 1. UI Imageから頂点座標とUV座標を受け取る
// 2. Vertex ShaderでUIを描画可能な座標へ変換する
// 3. UV座標から円の中心までの距離を求める
// 4. UV座標から現在のピクセルの角度を求める
// 5. FillAmountによって円形ゲージの描画範囲を制限する
// 6. flame_fire.hlslへ必要な情報を渡して炎の色を計算する
//============================================================


//============================================================
// テクスチャ
//============================================================

// UI Imageから渡されるSprite Texture
//
// .shader側で
//
// [PerRendererData] _MainTex
//
// と定義されているため、CanvasRendererから
// UI Imageに設定されたSprite Textureが渡される
sampler2D _MainTex;


//------------------------------------------------------------
// _MainTexのTilingとOffset
//
// xy = タイリング
// zw = オフセット
//
// TRANSFORM_TEXマクロで使用する
//------------------------------------------------------------
float4 _MainTex_ST;


//============================================================
// 炎の描画処理
//
// ノイズテクスチャの移動
// リング形状の生成
// リング外周のぼかし
// ゲージ先端位置の計算
// 先端炎の描画
//
// など、炎の見た目に関する処理を実装している
//============================================================
#include "Assets/masato/flame/flame_fire.hlsl"



//============================================================
// Vertex Shaderへ渡される頂点情報
//============================================================
struct Attributes
{
    //--------------------------------------------------------
    // UI Imageを構成する頂点のオブジェクト座標
    //--------------------------------------------------------
    float4 positionOS : POSITION;


    //--------------------------------------------------------
    // UI ImageのUV座標
    //
    // 左下 = (0, 0)
    // 右上 = (1, 1)
    //--------------------------------------------------------
    float2 uv : TEXCOORD0;
};



//============================================================
// Vertex ShaderからFragment Shaderへ渡す情報
//============================================================
struct Varyings
{
    //--------------------------------------------------------
    // クリップ空間座標
    //
    // Rasterizerが画面上のピクセルを生成するために必要
    //--------------------------------------------------------
    float4 positionCS : SV_POSITION;


    //--------------------------------------------------------
    // 補間されたUV座標
    //
    // Fragment Shaderで各ピクセルの位置計算に使用する
    //--------------------------------------------------------
    float2 uv : TEXCOORD0;
};



//============================================================
// Materialから渡されるShaderパラメータ
//============================================================

//------------------------------------------------------------
// 炎全体に乗算する色
//------------------------------------------------------------
float4 _Color;


//------------------------------------------------------------
// リングの内側半径
//
// UV中心からこの距離より内側はリングの外になる
//------------------------------------------------------------
float _InnerRadius;


//------------------------------------------------------------
// リングの外側半径
//
// UV中心からこの距離より外側はリングの外になる
//------------------------------------------------------------
float _OuterRadius;


//------------------------------------------------------------
// 円形ゲージの表示量
//
// 0.0 = 非表示
// 0.5 = 半周
// 1.0 = 一周
//------------------------------------------------------------
float _FillAmount;


//------------------------------------------------------------
// 円形ゲージの描画開始角度
//
// 0   = 12時
// 90  = 3時
// 180 = 6時
// 270 = 9時
//------------------------------------------------------------
float _StartAngle;



//============================================================
// 頂点シェーダー
//
// UI Imageの各頂点に対して実行される
//
// 主な処理
//
// 1. オブジェクト座標をクリップ空間座標へ変換
// 2. Main TextureのTiling / OffsetをUVへ適用
//============================================================
Varyings FlameVertex(Attributes input)
{
    //--------------------------------------------------------
    // Fragment Shaderへ渡すデータ
    //--------------------------------------------------------
    Varyings output;


    //--------------------------------------------------------
    // オブジェクト空間
    //
    // ↓
    //
    // クリップ空間
    //
    // へ座標変換する
    //
    // UnityObjectToClipPos内部では
    // Model View Projection変換が行われる
    //--------------------------------------------------------
    output.positionCS =
        UnityObjectToClipPos(input.positionOS);


    //--------------------------------------------------------
    // _MainTex_STを使用して
    //
    // Textureの
    //
    // タイリング
    // オフセット
    //
    // をUV座標へ適用する
    //--------------------------------------------------------
    output.uv =
        TRANSFORM_TEX(input.uv, _MainTex);


    //--------------------------------------------------------
    // Fragment Shaderへ値を渡す
    //--------------------------------------------------------
    return output;
}



//============================================================
// フラグメントシェーダー
//
// Rasterizerによって生成された各ピクセルごとに実行される
//
// 主な処理
//
// 1. UV中心から現在ピクセルまでの方向を求める
// 2. 中心からの距離を求める
// 3. atan2を使って現在ピクセルの角度を求める
// 4. 角度を0～1へ変換する
// 5. FillAmountより先のピクセルを透明にする
// 6. flame_fire.hlslへ情報を渡して最終色を求める
//============================================================
float4 FlameFragment(Varyings input) : SV_Target
{
    //--------------------------------------------------------
    // UV空間上の円の中心
    //
    // UV座標は
    //
    // 左下 = (0, 0)
    // 右上 = (1, 1)
    //
    // なので中心は (0.5, 0.5)
    //--------------------------------------------------------
    float2 center =
        float2(0.5, 0.5);


    //--------------------------------------------------------
    // 円の中心から現在のピクセルへ向かう方向ベクトル
    //
    // 例
    //
    // 現在UV = (0.8, 0.5)
    //
    // dir = (0.8, 0.5) - (0.5, 0.5)
    //
    //     = (0.3, 0.0)
    //
    // 円の右側を向くベクトルになる
    //--------------------------------------------------------
    float2 dir =
        input.uv - center;


    //--------------------------------------------------------
    // 円の中心から現在ピクセルまでの距離
    //
    // この値を使って
    //
    // 内側半径
    // 外側半径
    //
    // の判定を行う
    //
    // 実際のリング形状生成は
    // GetFlameColor側で行っている
    //--------------------------------------------------------
    float dist =
        length(dir);


    //--------------------------------------------------------
    // atan2を使って現在ピクセルの角度を求める
    //
    // atan2の戻り値
    //
    // -π ～ +π
    //
    // 右方向 =  0
    // 上方向 = +π/2
    // 左方向 = ±π
    // 下方向 = -π/2
    //--------------------------------------------------------
    float angle =
        atan2(dir.y, dir.x);


    //--------------------------------------------------------
    // Inspectorから渡された開始角度を
    //
    // 0～360度
    //
    // ↓
    //
    // 0～1
    //
    // の値へ変換する
    //
    // 例
    //
    // 0度   → 0.0
    // 90度  → 0.25
    // 180度 → 0.5
    // 270度 → 0.75
    //--------------------------------------------------------
    float start01 =
        _StartAngle / 360.0;


    //--------------------------------------------------------
    // atan2で取得した角度を
    // 円形ゲージ用の0～1の値へ変換する
    //
    //
    // angle / (2π)
    //
    // 角度を1周 = 1.0の値へ変換
    //
    //
    // 0.25 -
    //
    // atan2では右方向が0度なので、
    // 12時方向を0にするために0.25ずらす
    //
    //
    // マイナス
    //
    // atan2の反時計回りを
    // 時計回りへ変更する
    //
    //
    // - start01
    //
    // InspectorのStartAngle分だけ開始位置をずらす
    //
    //
    // frac()
    //
    // 結果を0～1の範囲に収める
    //
    //
    // 最終的に
    //
    // 0.0 = ゲージ開始位置
    //
    // 1.0 = 一周した位置
    //
    // となる
    //--------------------------------------------------------
    float angle01 =
        frac(
            0.25
            - angle / (2.0 * 3.14159265)
            - start01
        );


    //--------------------------------------------------------
    // FillAmountがほぼ0の場合
    // 全ピクセルを透明にする
    //
    // 完全な0との比較ではなく、
    // 小さな値を閾値として使用している
    //--------------------------------------------------------
    if (_FillAmount <= 0.0001)
    {
        return float4(0, 0, 0, 0);
    }


    //--------------------------------------------------------
    // 現在ピクセルの角度が
    // ゲージの表示量より先にある場合は透明にする
    //
    // 例
    //
    // FillAmount = 0.5
    //
    // angle01 <= 0.5
    //
    // → 描画
    //
    // angle01 > 0.5
    //
    // → 透明
    //--------------------------------------------------------
    if (angle01 > _FillAmount)
    {
        return float4(0, 0, 0, 0);
    }


    //--------------------------------------------------------
    // UI ImageのSprite Textureから色を取得する
    //
    // 取得したTexture色へ
    // InspectorのColorを乗算する
    //--------------------------------------------------------
    float4 baseColor =
        tex2D(_MainTex, input.uv)
        * _Color;


    //--------------------------------------------------------
    // 炎の見た目を計算する関数を呼び出す
    //
    // GetFlameColorはflame_fire.hlslに実装されている
    //
    // 渡している情報
    //
    // input.uv
    //     現在ピクセルのUV座標
    //
    // baseColor
    //     スプライトのテクスチャ × マテリアルの色
    //
    // angle01
    //     円周上の現在位置（0～1）
    //
    // dist
    //     円中心から現在ピクセルまでの距離
    //
    // _InnerRadius
    //     リング内側半径
    //
    // _OuterRadius
    //     リング外側半径
    //
    // _FillAmount
    //     ゲージ表示量
    //
    // _StartAngle
    //     ゲージ開始角度
    //--------------------------------------------------------
    return GetFlameColor(
        input.uv,
        baseColor,
        angle01,
        dist,
        _InnerRadius,
        _OuterRadius,
        _FillAmount,
        _StartAngle
    );
}

#endif
