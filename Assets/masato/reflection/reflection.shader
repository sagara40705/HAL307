Shader "Custom/reflection"
{
    Properties
    {
        // ====================================================
        // 床そのものの色
        // 鏡っぽくしたい場合はかなり暗くする
        // 例: (0.02, 0.02, 0.02, 1)
        // ====================================================
        [MainColor] _BaseColor("Base Color", Color) = (0.15, 0.15, 0.15, 1)

        // ====================================================
        // 床に貼るベーステクスチャ
        // 完全な鏡に近づけたい場合は白テクスチャでもよい
        // ====================================================
        [MainTexture] _BaseMap("Base Map", 2D) = "white" {}

        // ====================================================
        // 反射の基本強度
        // 0   = 反射しない
        // 1   = とても強い反射
        //
        // 鏡っぽくしたいなら 0.9 以上がおすすめ
        // ====================================================
        _ReflectStrength("Reflect Strength", Range(0, 1)) = 0.55

        // ====================================================
        // Fresnel の強さ
        // 小さいほど正面から見ても反射しやすい
        // 大きいほど斜めから見た時だけ強く反射する
        //
        // 鏡寄りなら 1.2 - 2.0 くらいから試すと扱いやすい
        // ====================================================
        _FresnelPower("Fresnel Power", Range(1, 8)) = 1.5


        // ====================================================
        //
        // 反射の粗さ
        //
        //=====================================================
        _Roughness("Roughness", Range(0, 1)) = 0.0
    }

    SubShader
    {
        Tags
        {
            // =================================================
            // URP 用シェーダーであることを示す
            // =================================================
            "RenderPipeline" = "UniversalPipeline"

            // =================================================
            // 今回は不透明の鏡面床として扱う
            // 半透明にしたい場合はここを変えるが、
            // まずは Opaque のままの方が安定する
            // =================================================
            "RenderType" = "Opaque"
            "Queue" = "Geometry"
        }

        Pass
        {
            Name "PlanarReflectionForward"

            HLSLPROGRAM

            // -----------------------------------------------
            // 頂点シェーダ
            // -----------------------------------------------
            #pragma vertex vert

            // -----------------------------------------------
            // ピクセルシェーダ
            // -----------------------------------------------
            #pragma fragment frag

            // -----------------------------------------------
            // URP の基本関数群
            // 座標変換やユーティリティを使うために必要
            // -----------------------------------------------
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

            // -----------------------------------------------
            // 実際の平面反射ロジック本体
            // vert / frag はここで定義している
            // -----------------------------------------------
            #include "reflection.hlsl"

            ENDHLSL
        }
    }
}
