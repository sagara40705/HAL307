Shader "Custom/SmokeParticle"
{
    //========================================================
    // Properties
    // - Material の Inspector に表示する項目
    // - ここで定義した名前を HLSL 側でも受け取る
    //========================================================
    Properties
    {
        //----------------------------------------------------
        // メインテクスチャ
        // 煙の元になる白黒マスク画像を入れる
        //----------------------------------------------------
        _MainTex ("Main Tex", 2D) = "white" {}

        //----------------------------------------------------
        // ノイズテクスチャ1
        // 1枚目の変形用ノイズ
        //----------------------------------------------------
        _NoiseTex1 ("Noise Tex 1", 2D) = "white" {}

        //----------------------------------------------------
        // ノイズテクスチャ2
        // 2枚目の変形用ノイズ
        //----------------------------------------------------
        _NoiseTex2 ("Noise Tex 2", 2D) = "white" {}

        //----------------------------------------------------
        // 煙の基本色
        //----------------------------------------------------
        _SmokeColor ("Smoke Color", Color) = (0.8, 0.8, 0.8, 1.0)

        //----------------------------------------------------
        // 煙全体の濃さ
        //----------------------------------------------------
        _Alpha ("Alpha", Range(0.0, 1.0)) = 0.7

        //----------------------------------------------------
        // ノイズ1の細かさ
        //----------------------------------------------------
        _NoiseScale1 ("Noise Scale 1", Range(0.1, 10.0)) = 2.0

        //----------------------------------------------------
        // ノイズ2の細かさ
        //----------------------------------------------------
        _NoiseScale2 ("Noise Scale 2", Range(0.1, 10.0)) = 4.0

        //----------------------------------------------------
        // ノイズ1の横方向スクロール
        //----------------------------------------------------
        _ScrollX1 ("Scroll X 1", Range(-5.0, 5.0)) = 0.05

        //----------------------------------------------------
        // ノイズ1の縦方向スクロール
        //----------------------------------------------------
        _ScrollY1 ("Scroll Y 1", Range(-5.0, 5.0)) = 0.3

        //----------------------------------------------------
        // ノイズ2の横方向スクロール
        //----------------------------------------------------
        _ScrollX2 ("Scroll X 2", Range(-5.0, 5.0)) = -0.03

        //----------------------------------------------------
        // ノイズ2の縦方向スクロール
        //----------------------------------------------------
        _ScrollY2 ("Scroll Y 2", Range(-5.0, 5.0)) = 0.15

        //----------------------------------------------------
        // ノイズのどこから煙として見せるか
        //----------------------------------------------------
        _Cutoff ("Cutoff", Range(0.0, 1.0)) = 0.25

        //----------------------------------------------------
        // 煙の輪郭の柔らかさ
        //----------------------------------------------------
        _Softness ("Softness", Range(0.001, 1.0)) = 0.2

        //----------------------------------------------------
        // 上方向にどれくらい薄くするか
        //----------------------------------------------------
        _TopFade ("Top Fade", Range(0.0, 5.0)) = 1.2

        //----------------------------------------------------
        // 端をどれくらい消すか
        //----------------------------------------------------
        _EdgeFade ("Edge Fade", Range(0.0, 5.0)) = 1.5
    }

    //========================================================
    // SubShader
    // - 実際の描画設定を書く場所
    //========================================================
    SubShader
    {
        //----------------------------------------------------
        // このシェーダーは透明物として扱う
        //----------------------------------------------------
        Tags
        {
            "RenderType"="Transparent"
            "Queue"="Transparent"
            "RenderPipeline"="UniversalPipeline"
        }

        Pass
        {
            Name "ForwardSmokeParticle"

            //------------------------------------------------
            // 半透明合成
            //------------------------------------------------
            Blend SrcAlpha OneMinusSrcAlpha

            //------------------------------------------------
            // 裏面も描画
            //------------------------------------------------
            Cull Off

            //------------------------------------------------
            // 深度は書き込まない
            //------------------------------------------------
            ZWrite Off

            HLSLPROGRAM

            //------------------------------------------------
            // 使用する関数名
            //------------------------------------------------
            #pragma vertex vert
            #pragma fragment frag

            //------------------------------------------------
            // URP の基本関数
            //------------------------------------------------
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

            //------------------------------------------------
            // 計算本体
            //------------------------------------------------
            #include "SmokeParticle.hlsl"

            ENDHLSL
        }
    }
}